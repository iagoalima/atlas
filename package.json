{
  "name": "atlas",
  "version": "1.0.0",
  "description": "Bot Discord para gestão de solicitações, análise e entrega de condecorações.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/core/index.ts",
    "register": "tsx src/core/discord/register-commands.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/core/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "discord",
    "discord-bot",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "@devjacob/discord-html-transcripts": "^4.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iagoalima/atlas.git"
  },
  "bugs": {
    "url": "https://github.com/iagoalima/atlas/issues"
  },
  "homepage": "https://github.com/iagoalima/atlas#readme"
}
